**/.env
**/.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store

# Editor directories
.vscode/
.idea/

# Build outputs
/Frontend/dist/
/Frontend/build/
/Backend/dist/

# Coverage
/coverage/

# Misc
.parcel-cache/
.turbo/
.cache/
